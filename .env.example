# Copy the NAMES of these into Netlify's dashboard under:
# Site settings -> Environment variables
# Do NOT fill this file in and do NOT commit a filled-in version anywhere —
# it exists only to show you the exact variable names the functions expect.

# --- Supabase (Site settings -> Environment variables) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
PAYSTACK_SECRET_KEY=

# --- Gmail SMTP (use an App Password, never your real Gmail password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_NAME=Certify

# --- Misc ---
PUBLIC_SITE_URL=
